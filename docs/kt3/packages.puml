package "practice.rules\nИнтерфейс, базовый класс\nи два правила" as rules
package "practice.model\n11 сущностей, DataSet, RunContext" as model
package "practice.io\nJSON и валидация" as io
cli ..> service
cli ..> rules
cli ..> model
cli ..> io
service ..> model
service ..> rules
rules ..> model
rules ..> io
model ..> io
