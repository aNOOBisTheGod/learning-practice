<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_KT2" targetNamespace="https://example.org/server-acceptance">
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Initiator" name="Инициатор заявки" />
    <bpmn:participant id="Team" name="Сборка и приёмочное тестирование сервера" processRef="Process" />
    <bpmn:messageFlow id="RequestMessage" sourceRef="Initiator" targetRef="Start" />
  </bpmn:collaboration>
  <bpmn:process id="Process" name="Сборка и приёмочное тестирование сервера" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="Kit" name="Ответственный за комплектование">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>KitTask</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Build" name="Инженер сборки">
        <bpmn:flowNodeRef>Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Parts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Assemble</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Power</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Post</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Config</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConfigOK</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Test" name="Инженер испытаний">
        <bpmn:flowNodeRef>Run</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Protocol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Defect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Accept" name="Ответственный за приёмку">
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pass</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Заявка и комплект получены">
      <bpmn:outgoing>F0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_message" />
    </bpmn:startEvent>
    <bpmn:manualTask id="KitTask" name="Передать комплект и документы">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Register" name="Зарегистрировать заявку и прогон">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Inspect" name="Проверить детали по документации">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Parts" name="Комплект пригоден?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Assemble" name="Собрать сервер">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Power" name="Выполнить первое включение">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Post" name="POST успешен?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Config" name="Сверить конфигурацию со спецификацией">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ConfigOK" name="Совпадает?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Run" name="Выполнить план испытаний">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Evaluate" name="Проверить готовность протокола">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Protocol" name="Сформировать протокол">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Review" name="Рассмотреть протокол">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Ready" name="Допуск подтверждён?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Pass" name="Сервер и протокол переданы">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Defect" name="Зафиксировать несоответствия">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Return" name="Возврат на доработку">
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="Start" targetRef="KitTask" name="" />
    <bpmn:sequenceFlow id="F1" sourceRef="KitTask" targetRef="Register" name="" />
    <bpmn:sequenceFlow id="F2" sourceRef="Register" targetRef="Inspect" name="" />
    <bpmn:sequenceFlow id="F3" sourceRef="Inspect" targetRef="Parts" name="" />
    <bpmn:sequenceFlow id="F4" sourceRef="Parts" targetRef="Assemble" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="Assemble" targetRef="Power" name="" />
    <bpmn:sequenceFlow id="F6" sourceRef="Power" targetRef="Post" name="" />
    <bpmn:sequenceFlow id="F7" sourceRef="Post" targetRef="Config" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" sourceRef="Config" targetRef="ConfigOK" name="" />
    <bpmn:sequenceFlow id="F9" sourceRef="ConfigOK" targetRef="Run" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10" sourceRef="Run" targetRef="Evaluate" name="" />
    <bpmn:sequenceFlow id="F11" sourceRef="Evaluate" targetRef="Protocol" name="" />
    <bpmn:sequenceFlow id="F12" sourceRef="Protocol" targetRef="Review" name="" />
    <bpmn:sequenceFlow id="F13" sourceRef="Review" targetRef="Ready" name="" />
    <bpmn:sequenceFlow id="F14" sourceRef="Ready" targetRef="Pass" name="да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F15" sourceRef="Parts" targetRef="Defect" name="нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16" sourceRef="Post" targetRef="Defect" name="нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F17" sourceRef="ConfigOK" targetRef="Defect" name="нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F18" sourceRef="Ready" targetRef="Defect" name="нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F19" sourceRef="Defect" targetRef="Return" name="" />
    <bpmn:dataObject id="DOrder_object" />
    <bpmn:dataObjectReference id="DOrder" name="Заявка; спецификация&#10;orders / spec_items" dataObjectRef="DOrder_object" />
    <bpmn:dataObject id="DModels_object" />
    <bpmn:dataObjectReference id="DModels" name="Каталог моделей&#10;models" dataObjectRef="DModels_object" />
    <bpmn:dataObject id="DComponents_object" />
    <bpmn:dataObjectReference id="DComponents" name="Компоненты; состав&#10;components / run_components" dataObjectRef="DComponents_object" />
    <bpmn:dataObject id="DSpec_object" />
    <bpmn:dataObjectReference id="DSpec" name="Спецификация&#10;spec_items" dataObjectRef="DSpec_object" />
    <bpmn:dataObject id="DPlan_object" />
    <bpmn:dataObjectReference id="DPlan" name="План; состав; тесты&#10;plans / plan_tests / tests" dataObjectRef="DPlan_object" />
    <bpmn:dataObject id="DRun_object" />
    <bpmn:dataObjectReference id="DRun" name="Карточка прогона&#10;runs" dataObjectRef="DRun_object" />
    <bpmn:dataObject id="DResults_object" />
    <bpmn:dataObjectReference id="DResults" name="Результаты&#10;results" dataObjectRef="DResults_object" />
    <bpmn:dataObject id="DDefects_object" />
    <bpmn:dataObjectReference id="DDefects" name="Дефекты&#10;defects" dataObjectRef="DDefects_object" />
    <bpmn:dataObject id="DProtocol_object" />
    <bpmn:dataObjectReference id="DProtocol" name="Протокол&#10;(представление)" dataObjectRef="DProtocol_object" />
    <bpmn:association id="ADOrder" sourceRef="DOrder" targetRef="Register" associationDirection="None" />
    <bpmn:association id="ADModels" sourceRef="DModels" targetRef="Inspect" associationDirection="None" />
    <bpmn:association id="ADComponents" sourceRef="DComponents" targetRef="Assemble" associationDirection="None" />
    <bpmn:association id="ADSpec" sourceRef="DSpec" targetRef="Config" associationDirection="None" />
    <bpmn:association id="ADPlan" sourceRef="DPlan" targetRef="Run" associationDirection="None" />
    <bpmn:association id="ADRun" sourceRef="DRun" targetRef="Register" associationDirection="None" />
    <bpmn:association id="ADResults" sourceRef="DResults" targetRef="Run" associationDirection="None" />
    <bpmn:association id="ADDefects" sourceRef="DDefects" targetRef="Defect" associationDirection="None" />
    <bpmn:association id="ADProtocol" sourceRef="DProtocol" targetRef="Protocol" associationDirection="None" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
